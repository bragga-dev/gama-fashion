# Em dev deixe /api (o proxy do Vite encaminha para o backend). Em produção: https://api.seudominio.com/api
VITE_API_URL=/api
# Alvo do proxy do Vite em dev
VITE_PROXY_TARGET=http://localhost:8000
# Mesmo GOOGLE_CLIENT_ID do backend (deixe vazio para ocultar o botão Google)
VITE_GOOGLE_CLIENT_ID=
# WhatsApp da loja (somente dígitos, com DDI) — opcional
VITE_WHATSAPP=
